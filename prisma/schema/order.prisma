model Order {
  id             String         @id @default(uuid())
  userId         String
  status         ORDERSTATUS    @default(PENDING)
  totalAmount    Float
  couponCode     String?
  discountAmount Float?
  payableAmount  Float          @default(0)
  address        String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deliveryStatus DELIVERYSTATUS @default(PENDING_PICKUP)
  riderId        String?
  items          OrderItem[]
  rider          Rider?         @relation(fields: [riderId], references: [id])
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([riderId])
  @@map("order")
}

model OrderItem {
  id         String @id @default(uuid())
  orderId    String
  mealId     String
  providerId String
  quantity   Int
  price      Float
  meal       Meal   @relation(fields: [mealId], references: [id])
  order      Order  @relation(fields: [orderId], references: [id])

  @@index([providerId])
}

enum ORDERSTATUS {
  PENDING
  ACCEPTED
  PREPARING
  READY
  ACCEPTED_BY_RIDER
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
  ASSIGNED
}

enum DELIVERYSTATUS {
  PENDING_PICKUP
  PICKED_UP
  ON_THE_WAY
  DELIVERED
}
